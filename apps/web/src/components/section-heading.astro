---
/** "01 — LABEL", a title and an intro, like the case studies on dawn.studio. */
interface Props {
	number: string;
	label: string;
	title: string;
	class?: string;
}
const { number, label, title, class: className } = Astro.props;
---

<div class:list={["flex max-w-2xl flex-col gap-3", className]}>
	<p class="flex items-center gap-3 font-mono text-[0.6875rem] tracking-[0.14em] text-muted-foreground uppercase">
		<span class="text-brand-ink">{number}</span>
		<span class="h-px w-6 bg-border"></span>
		{label}
	</p>
	<h2 class="text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-[2.75rem] sm:leading-[1.08]">
		{title}
	</h2>
	<div class="text-lg text-pretty text-muted-foreground"><slot /></div>
</div>
