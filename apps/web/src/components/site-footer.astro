---
import { releasesUrl, SITE } from "../site";
import Logo from "./logo.astro";

const year = new Date().getFullYear();
const columns = [
	{
		title: "Product",
		links: [
			{ href: "/#features", label: "Features" },
			{ href: "/#tour", label: "Tour" },
			{ href: "/download", label: "Download" },
			{ href: "/changelog", label: "Changelog" },
		],
	},
	{
		title: "Resources",
		links: [
			{ href: "/download#first-launch", label: "Installing" },
			{ href: releasesUrl, label: "Releases" },
			{ href: `https://github.com/${SITE.repo}`, label: "Source on GitHub" },
		],
	},
];
---

<footer class="border-t">
	<div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-[minmax(0,1.4fr)_repeat(2,minmax(0,1fr))]">
		<div class="flex max-w-xs flex-col gap-4">
			<Logo />
			<p class="text-sm text-muted-foreground">
				Local-first invoicing for freelancers and small studios. Made by {SITE.by}.
			</p>
			<span class="inline-flex items-center gap-2 self-start rounded-full border px-2.5 py-1 text-xs text-muted-foreground">
				<span class="relative flex size-2">
					<span class="absolute inline-flex size-full animate-ping rounded-full bg-primary opacity-60"></span>
					<span class="relative inline-flex size-2 rounded-full bg-primary"></span>
				</span>
				Works offline
			</span>
		</div>
		{
			columns.map((column) => (
				<div class="flex flex-col gap-2.5 text-sm">
					<span class="font-mono text-xs tracking-wider text-muted-foreground uppercase">
						{column.title}
					</span>
					{column.links.map((link) => (
						<a href={link.href} class="text-foreground/80 transition-colors hover:text-foreground">
							{link.label}
						</a>
					))}
				</div>
			))
		}
	</div>
	<div class="mx-auto flex max-w-6xl items-center justify-between px-5 pb-10 text-xs text-muted-foreground">
		<span>© {year} {SITE.by}</span>
		<a href="#content" class="hover:text-foreground">Back to top ↑</a>
	</div>
</footer>
