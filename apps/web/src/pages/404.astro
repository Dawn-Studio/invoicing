---
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout title="Page not found" noindex>
	<section class="mx-auto flex max-w-xl flex-col items-center gap-4 px-5 py-32 text-center">
		<p class="font-mono text-sm text-brand-ink">404</p>
		<h1 class="text-3xl font-semibold tracking-tight">This page doesn't exist</h1>
		<p class="text-muted-foreground">It may have moved. The app and everything about it is a click away.</p>
		<div class="mt-4 flex gap-3">
			<a href="/" class="inline-flex h-10 items-center rounded-lg bg-primary px-4 font-medium text-primary-foreground hover:brightness-95">Home</a>
			<a href="/download" class="inline-flex h-10 items-center rounded-lg border px-4 font-medium hover:bg-accent">Download</a>
		</div>
	</section>
</BaseLayout>
